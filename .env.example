# Configuration template. Real values belong only in the ignored root .env.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=factoring_coach
MYSQL_USER=factoring_app
MYSQL_PASSWORD=
REDIS_PASSWORD=
CHECKPOINT_REDIS_PASSWORD=
MINIO_ROOT_USER=factoring_minio
MINIO_ROOT_PASSWORD=

# Cloud keys: fill locally. Never copy the template over an existing .env.
DEEPSEEK_API_KEY=
ALIYUN_API_KEY=

# Application addresses and credentials; references reuse the middleware values.
# Remote deployment: override the APP_* host/port keys below in the local .env.
# Also set APP_LANGGRAPH__CHECKPOINT__PASSWORD to that server's Stack credential.
# Keep database/collection names and credentials consistent with the chosen server;
# never replace an existing .env wholesale or put remote credentials in this template.
APP_DATABASE__MYSQL__HOST=127.0.0.1
APP_DATABASE__MYSQL__PORT=3307
APP_DATABASE__MYSQL__DATABASE=${MYSQL_DATABASE}
APP_DATABASE__MYSQL__USER=${MYSQL_USER}
APP_DATABASE__MYSQL__PASSWORD=${MYSQL_PASSWORD}
APP_DATABASE__REDIS__HOST=127.0.0.1
APP_DATABASE__REDIS__PORT=6379
APP_DATABASE__REDIS__PASSWORD=${REDIS_PASSWORD}
APP_RAG__VECTOR_DATABASE__HOST=127.0.0.1
APP_RAG__VECTOR_DATABASE__PORT=19530
APP_RAG__VECTOR_DATABASE__COLLECTION=factoring_knowledge_v2
APP_LANGGRAPH__WORKFLOW_NAME=coach_graph
APP_LANGGRAPH__CHECKPOINT__HOST=127.0.0.1
APP_LANGGRAPH__CHECKPOINT__PORT=6380
# Independent checkpoint credential; wired in M1-1.3.
APP_LANGGRAPH__CHECKPOINT__PASSWORD=${CHECKPOINT_REDIS_PASSWORD}

# Auth configuration is loaded; JWT/roles are implemented separately in M5.
APP_AUTH__JWT_SECRET=

# Design defaults, configured but NOT verified against cloud services.
APP_SERVER__HOST=127.0.0.1
APP_SERVER__PORT=8000
APP_LLM__API__BASE_URL=https://api.deepseek.com
APP_LLM__API__API_KEY=${DEEPSEEK_API_KEY}
APP_LLM__MODELS__REASONING__NAME=deepseek-v4-pro
APP_LLM__MODELS__CHAT__NAME=deepseek-v4-flash
APP_RAG__EMBEDDING__PROVIDER=dashscope
APP_RAG__EMBEDDING__MODEL=qwen3.7-text-embedding
APP_RAG__EMBEDDING__DIMENSION=1024
APP_RAG__EMBEDDING__API_KEY=${ALIYUN_API_KEY}
APP_RAG__EMBEDDING__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
APP_RAG__RETRIEVAL__RERANK__ENABLED=true
APP_RAG__RETRIEVAL__RERANK__PROVIDER=dashscope
APP_RAG__RETRIEVAL__RERANK__MODEL=qwen3.7-text-rerank
APP_RAG__RETRIEVAL__RERANK__API_KEY=${ALIYUN_API_KEY}
APP_RAG__RETRIEVAL__RERANK__BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
